# Google Cloud (replaces both ANTHROPIC_API_KEY and OPENAI_API_KEY)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-east5

# For local dev: run `gcloud auth application-default login`
# For Railway/production: paste the full JSON content of your service account key
GOOGLE_CREDENTIALS_JSON=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Upstash Redis
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=...

# Optional: Tavily (for live research in posts)
TAVILY_API_KEY=tvly-...

# Optional: LangSmith tracing
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=infinitybox-linkedin-agent
LANGCHAIN_TRACING_V2=true

FRONTEND_URL=https://your-vercel-app.vercel.app
